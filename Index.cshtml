@model List<MyResultRow>
@{
    ViewData["Title"] = "My results";
}
<div class="rd-page-head">
    <h1>My results</h1>
    <p>Your race history across the events you took part in.</p>
</div>

@if (!Model.Any())
{
    <div class="rd-empty">
        <p>No results yet. Results appear here once an organiser publishes them after the event.</p>
    </div>
}
else
{
    <div class="rd-card">
        <div class="table-responsive">
            <table class="table rd-table align-middle mb-0">
                <thead>
                    <tr><th>Event</th><th>Date</th><th>Category</th><th>Finish time</th><th>Position</th><th>Status</th></tr>
                </thead>
                <tbody>
                    @foreach (var row in Model)
                    {
                        <tr>
                            <td>@row.EventName</td>
                            <td>@(row.EventDate?.ToString("dd MMM yyyy") ?? "-")</td>
                            <td>@row.CategoryName</td>
                            <td class="rd-time">@fmt.time(row.FinishTime)</td>
                            <td>
                                @if (row.Position != null)
                                {
                                    <strong>@fmt.ordinal(row.Position.Value)</strong>
                                    <span class="text-muted"> out of @row.TotalFinishers finishers</span>
                                }
                                else
                                {
                                    <span>-</span>
                                }
                            </td>
                            <td><partial name="_StatusBadge" model="row.Status" /></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
