@{
    bool logged_in = Context.Session.is_logged_in();
    string current_role = Context.Session.role();
    string current_name = Context.Session.full_name();
    string current_controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#6c2bff" />
    <title>@ViewData["Title"] - RaceDay</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Unbounded:wght@500;700;800;900&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
</head>
<body>
    <div class="rd-ticker" aria-hidden="true">
        <div class="rd-ticker-track">
            @foreach (var copy in new[] { 0, 1 })
            {
                <div class="rd-ticker-group">
                    @foreach (var word in new[] { "Run", "Walk", "Cycle", "Enrol", "Race", "Finish strong", "Results on the day" })
                    {
                        <span>@word</span>
                    }
                </div>
            }
        </div>
    </div>
    <nav class="navbar navbar-expand-lg navbar-dark rd-navbar">
        <div class="container">
            <a class="navbar-brand rd-brand" asp-controller="Home" asp-action="Index">RACE<span>DAY</span></a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#rdMenu" aria-controls="rdMenu" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="rdMenu">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    @if (logged_in && current_role == "Organiser")
                    {
                        <li class="nav-item"><a class="nav-link @(current_controller == "Dashboard" ? "active" : "")" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                        <li class="nav-item"><a class="nav-link @(current_controller == "ManageEvents" ? "active" : "")" asp-controller="ManageEvents" asp-action="Index">Events</a></li>
                        <li class="nav-item"><a class="nav-link @(current_controller == "ManageCategories" ? "active" : "")" asp-controller="ManageCategories" asp-action="Index">Categories</a></li>
                        <li class="nav-item"><a class="nav-link @(current_controller == "ManageEnrolments" ? "active" : "")" asp-controller="ManageEnrolments" asp-action="Index">Enrolments</a></li>
                        <li class="nav-item"><a class="nav-link @(current_controller == "ManageResults" ? "active" : "")" asp-controller="ManageResults" asp-action="Index">Results</a></li>
                    }
                    else if (logged_in && current_role == "Participant")
                    {
                        <li class="nav-item"><a class="nav-link @(current_controller == "Home" || current_controller == "Events" ? "active" : "")" asp-controller="Home" asp-action="Index">Events</a></li>
                        <li class="nav-item"><a class="nav-link @(current_controller == "MyEnrolments" ? "active" : "")" asp-controller="MyEnrolments" asp-action="Index">My Enrolments</a></li>
                        <li class="nav-item"><a class="nav-link @(current_controller == "MyResults" ? "active" : "")" asp-controller="MyResults" asp-action="Index">My Results</a></li>
                    }
                </ul>
                <ul class="navbar-nav align-items-lg-center gap-lg-2">
                    @if (logged_in)
                    {
                        <li class="nav-item">
                            <a class="nav-link d-flex align-items-center gap-2 @(current_controller == "Profile" ? "active" : "")" asp-controller="Profile" asp-action="Index">
                                <img src="@Url.Action("Profile", "Images")" class="rd-avatar-sm" alt="Your profile picture" />
                                <span>@current_name</span>
                                <span class="badge rd-role-badge">@current_role</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                <button type="submit" class="btn btn-outline-light btn-sm">Log out</button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">Log in</a></li>
                        <li class="nav-item"><a class="btn btn-primary btn-sm" asp-controller="Account" asp-action="Register">Sign up</a></li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <main class="container rd-main">
        @if (TempData["ok"] is string ok_message)
        {
            <div class="alert alert-success rd-alert" role="alert">@ok_message</div>
        }
        @if (TempData["warn"] is string warn_message)
        {
            <div class="alert alert-warning rd-alert" role="alert">@warn_message</div>
        }
        @if (TempData["error"] is string error_message)
        {
            <div class="alert alert-danger rd-alert" role="alert">@error_message</div>
        }
        @RenderBody()
    </main>

    <footer class="rd-footer">
        <div class="container d-flex flex-wrap justify-content-between gap-2">
            <span class="rd-brand-small">RACE<span>DAY</span></span>
            <span>Find your next finish line.</span>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
